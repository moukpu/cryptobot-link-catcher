[Unit]
Description=Telegram CryptoBot start-link userbot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
User=telegram-userbot
Group=telegram-userbot
WorkingDirectory=/opt/cryptobot-userbot
EnvironmentFile=/opt/cryptobot-userbot/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/cryptobot-userbot/.venv/bin/python -m app.main
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/opt/cryptobot-userbot/session /opt/cryptobot-userbot/data
RestrictSUIDSGID=true
LockPersonality=true
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
