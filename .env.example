# Получить на https://my.telegram.org/apps
API_ID=PASTE_API_ID_HERE
API_HASH=PASTE_API_HASH_HERE

# Номер пользовательского аккаунта в международном формате
PHONE_NUMBER=+000000000000

# Пути можно оставить относительными: они считаются от корня проекта.
SESSION_PATH=session/telegram_user
DB_PATH=data/processed.sqlite3
LOG_FILE=data/userbot.log
LOG_LEVEL=INFO

# Повторы одной операции при временной сетевой/RPC-ошибке.
SEND_RETRIES=5
RETRY_BASE_SECONDS=3

# Максимальный FloodWait, который процесс ждёт автоматически.
MAX_FLOOD_WAIT_SECONDS=3600

# Необязательная закрытая панель управления.
# Создайте отдельного бота через @BotFather. CONTROL_ADMIN_ID можно не
# заполнять: тогда доступ автоматически получит авторизованный аккаунт.
CONTROL_BOT_TOKEN=
CONTROL_ADMIN_ID=
CONTROL_SESSION_PATH=session/control_bot
